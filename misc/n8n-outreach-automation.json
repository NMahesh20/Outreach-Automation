      "id": "703988e6-98f9-4531-a65b-1f238c61e2ae",
      "name": "Google Scholar Search via SerpAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1504,
        656
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract SerpAPI data\nconst response = $input.first().json;\nconst organicResults = response.organic_results || [];\n\n// ---- 1. Limit to first 20 papers ----\nconst limitedResults = organicResults.slice(0, 20);\n\nconst final = [];\n\nlimitedResults.forEach((paper, index) => {\n  \n  // ---- 2. Find first PDF resource (if any) ----\n  let pdf_url = null;\n\n  if (paper.resources && Array.isArray(paper.resources)) {\n    const pdfRes = paper.resources.find(r => r.file_format === \"PDF\");\n    if (pdfRes) {\n      pdf_url = pdfRes.link || null;\n    }\n  }\n\n  // ---- 3. Build summary combining snippet + publication summary if exists ----\n  const snippet = paper.snippet || \"\";\n  const pubSummary = paper.publication_info?.summary || \"\";\n  \n  const summary = [snippet, pubSummary]\n    .filter(s => s && s.trim() !== \"\")\n    .join(\" | \"); // combine cleanly\n\n  // ---- 4. Push final object ----\n  final.push({\n    paper_title: paper.title || \"\",\n    pdf_url,\n    summary\n  });\n});\n\nreturn final.map(item => ({ json: item }));\n"
      },
