    {
      "parameters": {
        "promptType": "define",
        "text": "=Paper Title: {{ $json.paper_title }}\nAuthors: {{ $json.emails[0] }}\nAbstract: {{ $json.summary }}\n\nMy Background:\nResearch Interest: {{ $('Workflow Configuration').item.json.body.topic }}\nSkills: {{ $('Workflow Configuration').item.json.body.skills }}\nPosition Seeking: {{ $('Workflow Configuration').item.json.body.position }}\n\nMy Name: \"John\"\n",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an academic outreach email writer. Your task is to compose a professional, personalized email to research paper authors.\n\nGuidelines:\n1. Introduce yourself in the context of the specific paper mentioned\n2. Reference specific aspects of their research that align with your interests\n3. Highlight how your skills and background relate to their work\n4. Clearly state the position you are seeking (PhD, Postdoc, etc.)\n5. Be concise, professional, and genuine\n6. Keep the email under 250 words\n7. Include a clear call-to-action\n8. Return ONLY the email body text and mail subject with proper paragraphing, no subject line\n9. Include generic salutations and closing regards. If more than 2 authors refer them as \"Authors\"\n\nTone: Professional, enthusiastic but not overeager, respectful\n\n"
        }
      },
